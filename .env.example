# ============================================================
#  .env.example
#  Copy this file to ".env" and fill in your real keys.
#  NEVER commit the real ".env" file to git.
# ============================================================

# ---- 🔑 REQUIRED API KEYS ----
OPENAI_API_KEY=sk-your-openai-key-here
PINECONE_API_KEY=pcsk-your-pinecone-key-here

# ---- 📄 PDF / Ingestion ----
PDF_DIR=data
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---- 🧠 Embeddings ----
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_DIM=768

# ---- 🌲 Pinecone ----
PINECONE_INDEX_NAME=medical-chatbot-hybrid
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- 🔀 Hybrid retrieval ----
HYBRID_ALPHA=0.6
TOP_K_RETRIEVE=20
TOP_K_RERANK=4

# ---- 🏆 Reranker ----
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- 🤖 OpenAI LLM ----
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=600

# ---- 💬 Memory ----
MEMORY_MAX_TURNS=6

# ---- 🖥️ Flask ----
FLASK_HOST=0.0.0.0
FLASK_PORT=7860
FLASK_DEBUG=False
